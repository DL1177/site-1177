---
// src/components/SlideshowObras.astro
// Slideshow de Grandes Obras de Saúde (Rio Imagem Baixada & Onco Baixada)
// Design Editorial de Ponta a Ponta com Transição Suave e Integração Orgânica na Seção Entregas

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const fotosObras = [
  {
    id: 1,
    src: `${baseUrl}/obras/rio-imagem-fachada.webp`,
    alt: "Fachada oficial do Rio Imagem Baixada às margens da Rodovia Presidente Dutra",
    titulo: "Rio Imagem Baixada",
    local: "Nova Iguaçu • Polo Regional",
    legenda: "Maior centro público de exames por imagem da América Latina",
    posicao: "object-center sm:object-[center_35%]",
  },
  {
    id: 2,
    src: `${baseUrl}/obras/onco-baixada-aereo.webp`,
    alt: "Vista aérea panorâmica do Complexo Estadual de Saúde: Rio Imagem Baixada e Onco Baixada na Rodovia Presidente Dutra",
    titulo: "Complexo Regional de Saúde",
    local: "Via Dutra • Baixada Fluminense",
    legenda: "Polo integrado de alta complexidade atendendo os 92 municípios do Estado",
    posicao: "object-center",
  },
  {
    id: 3,
    src: `${baseUrl}/obras/rio-imagem-interno.webp`,
    alt: "Instalações modernas e tecnologia de ponta no interior do Rio Imagem Baixada",
    titulo: "Tecnologia de Ponta e Humanização",
    local: "Rio Imagem Baixada",
    legenda: "Ressonância magnética, tomografia e exames preventivos de alta precisão",
    posicao: "object-center sm:object-[center_40%]",
  },
  {
    id: 4,
    src: `${baseUrl}/obras/onco-baixada-complexo.webp`,
    alt: "Instituto Estadual de Oncologia da Baixada Fluminense (Onco Baixada)",
    titulo: "Onco Baixada",
    local: "Instituto Estadual de Oncologia",
    legenda: "100 leitos e 24 boxes de quimioterapia para tratamento do câncer",
    posicao: "object-center sm:object-[center_35%]",
  },
];
---

<div id="obras-slideshow" class="relative w-full h-80 sm:h-96 md:h-[460px] lg:h-[520px] overflow-hidden select-none bg-slate-950">
  
  {fotosObras.map((foto, index) => (
    <div
      class={`obras-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
        index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
      }`}
      data-index={index}
    >
      <!-- Foto de Ponta a Ponta, do Teto Superior à Base -->
      <img
        src={foto.src}
        alt={foto.alt}
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
        class={`w-full h-full object-cover filter contrast-105 ${foto.posicao}`}
      />

      <!-- Legenda Editorial Compacta e Elegante no rodapé do slide -->
      <div class="absolute bottom-12 sm:bottom-16 md:bottom-20 left-4 sm:left-6 md:left-8 lg:left-12 z-20 pointer-events-none">
        <div class="inline-flex items-center gap-2.5 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-black/60 backdrop-blur-md border border-white/20 text-white shadow-xl pointer-events-auto max-w-[90vw] sm:max-w-md">
          <span class="w-2.5 h-2.5 rounded-full bg-[#F15A29] shrink-0 animate-pulse"></span>
          <div class="overflow-hidden">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-display font-black italic text-sm sm:text-base tracking-tight text-white leading-none">
                {foto.titulo}
              </span>
              <span class="text-[11px] sm:text-xs text-orange-200/90 font-medium">
                • {foto.local}
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-300 font-normal leading-snug line-clamp-1 mt-0.5">
              {foto.legenda}
            </p>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- Gradiente sutil no topo para acabamento e contraste dos controles -->
  <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/40 to-transparent pointer-events-none z-10"></div>

  <!-- Gradiente na base fundindo com o fundo branco da seção #entregas -->
  <div class="absolute inset-x-0 bottom-0 h-28 sm:h-36 md:h-44 bg-gradient-to-t from-white via-white/85 to-transparent pointer-events-none z-10"></div>

  <!-- Badge no Topo Esquerdo -->
  <div class="absolute top-5 left-4 sm:top-6 sm:left-8 z-20 pointer-events-none">
    <span class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white/95 text-[#123F8F] font-sans text-xs font-bold uppercase tracking-wider shadow-md pointer-events-auto backdrop-blur-sm border border-white/40">
      GRANDES OBRAS DO ESTADO
    </span>
  </div>

  <!-- Indicadores de Paginação Discretos no Topo Direito -->
  <div class="absolute top-5 right-4 sm:top-6 sm:right-8 z-20 flex items-center gap-1.5 bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 pointer-events-auto shadow-lg">
    {fotosObras.map((_, index) => (
      <button
        type="button"
        class={`obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${
          index === 0 ? 'w-5 bg-[#F15A29]' : 'w-1.5 bg-white/40 hover:bg-white/70'
        }`}
        data-index={index}
        aria-label={`Foto da obra ${index + 1}`}
      />
    ))}
  </div>

</div>

<!-- Script dedicado do Slideshow de Obras -->
<script>
  function setupObrasSlideshow() {
    const container = document.getElementById('obras-slideshow');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.obras-slide');
    const dots = container.querySelectorAll<HTMLElement>('.obras-dot');
    const total = slides.length;
    if (total <= 1) return;

    let current = 0;
    let timer: any = null;

    function show(index: number) {
      current = (index + total) % total;
      slides.forEach((s, idx) => {
        if (idx === current) {
          s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          s.classList.add('opacity-100', 'z-10');
        } else {
          s.classList.remove('opacity-100', 'z-10');
          s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((d, idx) => {
        if (idx === current) {
          d.className = 'obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-5 bg-[#F15A29]';
        } else {
          d.className = 'obras-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer w-1.5 bg-white/40 hover:bg-white/70';
        }
      });
    }

    function next() {
      show(current + 1);
    }

    function start() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 4000);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        show(idx);
        start();
      });
    });

    start();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupObrasSlideshow);
  } else {
    setupObrasSlideshow();
  }
  document.addEventListener('astro:page-load', setupObrasSlideshow);
</script>
