---
// src/components/MarcosNacionais.astro
// Leis e Marcos Nacionais — Design Editorial com Carrossel Horizontal e Cards Idênticos ao Pelo Rio
const MARCOS = [
  {
    esfera: 'Congresso Nacional',
    badge: 'Lei Sancionada',
    titulo: 'Complexo Industrial da Saúde',
    subtitulo: 'Autonomia e soberania farmacêutica',
    metricaValor: 'Lei nº 15.471/2026',
    metricaRotulo: 'Legislação Federal',
    descricao: 'Primeiro signatário e autor do projeto histórico criado na pandemia para reduzir a dependência do Brasil de respiradores, medicamentos, vacinas e insumos importados, garantindo soberania produtiva ao SUS.',
    destaque: 'Marco legal definitivo que estimula a indústria nacional de saúde e protege a vida dos brasileiros contra crises externas de abastecimento.'
  },
  {
    esfera: 'Câmara dos Deputados',
    badge: 'Presidência Especial',
    titulo: 'Enfrentamento da Covid-19',
    subtitulo: 'Coordenação e resposta do SUS',
    metricaValor: 'Comissão Especial',
    metricaRotulo: 'Articulação Nacional',
    descricao: 'Presidiu a comissão especial da Câmara durante a pandemia, atuando diretamente em parceria com a Fiocruz, Instituto Butantan, OPAS e Ministério da Saúde pela chegada célere de vacinas, leitos e insumos.',
    destaque: 'Atuação decisiva na chegada célere de vacinas, compra emergencial de respiradores e custeio das UTIs públicas.'
  },
  {
    esfera: 'Congresso Nacional',
    badge: 'Lei Sancionada',
    titulo: 'Programa Pró-Leitos',
    subtitulo: 'Leitos de UTI privados para o SUS',
    metricaValor: 'Lei nº 14.147/2021',
    metricaRotulo: 'Legislação Federal',
    descricao: 'Autor da lei emergencial que viabilizou a utilização de leitos privados de UTI para atendimento 100% gratuito de pacientes graves do SUS durante o momento mais crítico da pandemia no país.',
    destaque: 'Milhares de vidas salvas com leitos de UTI cobertos integralmente pelo SUS nos hospitais da rede privada.'
  },
  {
    esfera: 'Qualidade Médica',
    badge: 'PL & Medida Provisória',
    titulo: 'Enamed: Avaliação da Medicina',
    subtitulo: 'Exame nacional de proficiência médica',
    metricaValor: 'MP nº 1.370/2026',
    metricaRotulo: 'PL 785/2024',
    descricao: 'Autor do projeto pioneiro na Câmara (PL 785/2024) que mobilizou o Congresso por uma avaliação nacional de proficiência médica, articulando a edição da Medida Provisória nº 1.370/2026 pelo Governo Federal.',
    destaque: 'Critério rigoroso na qualidade da formação médica e segurança absoluta no atendimento a pacientes de todo o país.'
  },
  {
    esfera: 'Atenção Primária',
    badge: 'Presidência de Comissão',
    titulo: 'Aposentadoria dos Agentes',
    subtitulo: 'Agentes Comunitários e Endemias',
    metricaValor: 'PEC 14/2021',
    metricaRotulo: 'Segurança Previdenciária',
    descricao: 'Presidente da Comissão Especial da Câmara que debate a aposentadoria especial e os direitos previdenciários dos Agentes Comunitários de Saúde e de Combate às Endemias, a força diária do SUS que visita os lares.',
    destaque: 'Segurança constitucional e aposentadoria justa a quem dedica a vida à linha de frente do SUS nas comunidades brasileiras.'
  },
  {
    esfera: 'Pacto Federativo',
    badge: 'Relator de Plenário',
    titulo: 'Relatoria do PROPAG',
    subtitulo: 'Equilíbrio fiscal e alívio das dívidas',
    metricaValor: 'LC nº 212/2025',
    metricaRotulo: 'R$ 41 Bilhões para o RJ',
    descricao: 'Relator de Plenário na Câmara dos Deputados do Programa de Pleno Pagamento de Dívidas dos Estados (PROPAG), garantindo corte de R$ 41 bilhões no saldo devedor do Rio e gerando alívio mensal de R$ 320 milhões.',
    destaque: 'R$ 320 milhões liberados mensalmente para financiar hospitais, custeio do SUS e obras públicas essenciais.'
  }
];
---

<section id="brasil" class="py-12 sm:py-16 md:py-20 bg-white relative border-b border-slate-200/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Cabeçalho Editorial: Tag + Título Grande Porte + Subtítulo -->
    <div class="max-w-3xl mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="w-4 h-[2px] bg-[#F15A29]"></span>
        <span class="text-xs font-bold text-[#123F8F] uppercase tracking-[0.2em]">POR TODO O BRASIL</span>
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-black italic tracking-tight leading-tight mb-3">
        <span class="text-[#123F8F]">LEIS E MARCOS QUE</span> <br />
        <span class="text-[#F15A29]">TRANSFORMARAM O BRASIL</span>
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 leading-relaxed">
        Projetos e leis federais relatados e aprovados que fortalecem a autonomia do país, expandem o SUS e salvam vidas.
      </p>
    </div>

    <!-- Controles Desktop & Dica no Mobile (Visível logo acima dos cards) -->
    <div class="flex items-center justify-between gap-4 mb-3 sm:mb-4">
      <!-- Dica de Deslize no Celular -->
      <div class="sm:hidden flex items-center gap-1.5 text-xs font-semibold text-slate-400">
        <svg class="w-4 h-4 text-[#F15A29]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span>Arraste para o lado</span>
      </div>

      <!-- Botões de Navegação Desktop -->
      <div class="hidden sm:flex items-center gap-2.5 ml-auto">
        <button
          id="marcos-prev"
          aria-label="Voltar marco anterior"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="marcos-next"
          aria-label="Avançar próximo marco"
          class="p-2.5 rounded-full border border-slate-200 bg-white text-slate-700 hover:bg-[#123F8F] hover:text-white hover:border-[#123F8F] shadow-sm hover:shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Trilho do Carrossel com Efeito Peek (próximo card visível cortado na lateral) -->
    <div class="relative">
      <div class="pointer-events-none absolute right-0 top-0 bottom-2 w-20 sm:w-28 bg-gradient-to-l from-white to-transparent z-10 hidden md:block"></div>

      <div
        id="marcos-track"
        class="flex gap-6 overflow-x-auto pb-2 pt-1 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-4 sm:mx-0 px-4 sm:px-0"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {MARCOS.map((marco) => (
          <div class="snap-start shrink-0 w-[76vw] sm:w-[320px] lg:w-[350px]">
            <article class="flex flex-col justify-between h-full bg-white border border-slate-200/90 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:border-[#F15A29]/40 rounded-2xl p-4 sm:p-5 transition-all duration-300 relative overflow-hidden group">
              <!-- Tarja superior de cor institucional -->
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#123F8F] via-[#1A54BD] to-[#F15A29]"></div>

              <div>
                <!-- Top Header: Esfera & Badge -->
                <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    {marco.esfera}
                  </span>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-50 text-[#F15A29] border border-orange-200/60 uppercase tracking-wide">
                    ★ {marco.badge}
                  </span>
                </div>

                <!-- Título do Marco -->
                <div class="mb-3">
                  <h3 class="font-display text-2xl sm:text-3xl font-black italic tracking-tight text-[#123F8F] leading-tight mb-1 group-hover:text-[#F15A29] transition-colors">
                    {marco.titulo}
                  </h3>
                  <p class="font-sans text-sm font-semibold text-slate-600 leading-snug">
                    {marco.subtitulo}
                  </p>
                </div>

                <!-- Métrica / Informação Complementar -->
                <div class="mb-3.5 flex items-baseline gap-2 flex-wrap">
                  <span class="font-display text-xl sm:text-2xl font-black italic text-[#F15A29] leading-none">
                    {marco.metricaValor}
                  </span>
                  <span class="font-sans text-xs text-slate-600 font-bold uppercase tracking-wider">
                    {marco.metricaRotulo}
                  </span>
                </div>

                <!-- Conteúdo Editorial -->
                <div class="space-y-3 font-sans text-[15px] sm:text-base text-slate-700 font-medium leading-relaxed">
                  <p class="leading-relaxed">
                    {marco.descricao}
                  </p>

                  <div class="flex items-start gap-2.5 p-3 rounded-xl bg-orange-50/70 border border-orange-200/80 text-slate-900 text-sm font-semibold leading-snug">
                    <span class="text-[#F15A29] font-bold text-sm shrink-0 mt-0.5">✓</span>
                    <span>{marco.destaque}</span>
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  function setupMarcosCarrossel() {
    const track = document.getElementById('marcos-track');
    const btnPrev = document.getElementById('marcos-prev');
    const btnNext = document.getElementById('marcos-next');

    if (!track || !btnPrev || !btnNext) return;

    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -360, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: 360, behavior: 'smooth' });
    });
  }

  setupMarcosCarrossel();
  document.addEventListener('astro:page-load', setupMarcosCarrossel);
</script>
